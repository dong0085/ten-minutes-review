DATABASE_URL=postgres://localhost:5432/ten_minute_review
AUTH_SECRET=
APP_URL=http://localhost:3000
INVITE_ONLY=true
INVITE_CODE=dev-invite

LLM_PROVIDER=mock
EMAIL_PROVIDER=console
STORAGE_PROVIDER=local

EMAIL_FROM=Ten Minutes Review <you@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
BREVO_API_KEY=
RESEND_API_KEY=
# Optional on Vercel when the Blob store is connected to the project (OIDC).
# Set it for local runs with STORAGE_PROVIDER=vercel (vercel env pull).
BLOB_READ_WRITE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GoatCounter analytics. Create a site at goatcounter.com and set this to its
# count endpoint (a self-hosted instance works too). Leave unset to disable.
# GOATCOUNTER_URL=https://YOURCODE.goatcounter.com/count

# Self-hosted S3 storage (Plan B). See docs/DEPLOY-AWS.md for the full setup.
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
