# Worker environment on the VM, stored at /etc/tmr/worker.env (root-only, mode 600).
# Docker reads it as-is: one KEY=value per line, no quotes, no `export`.

DATABASE_URL=
AUTH_SECRET=
APP_URL=

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=

STORAGE_PROVIDER=s3
S3_BUCKET=tmr-notes-513329232738
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
