# Copy to deploy/.env on the server. Compose reads it for its own settings and
# passes it to the web and worker containers. One KEY=value per line, no quotes.

# --- Host -------------------------------------------------------------------
# The domain Caddy serves and gets a certificate for.
DOMAIN=example.com
# Image tag to run. `latest` follows main; `sha-<7-char commit>` pins one build.
TAG=latest
# Anything other than `production` lets STRIPE_MODE=sandbox take effect.
APP_ENV=production
# Optional services on this host: db (Postgres + nightly backups), storage (MinIO).
# COMPOSE_PROFILES=db,storage

# --- App --------------------------------------------------------------------
APP_URL=https://example.com
# openssl rand -base64 32
AUTH_SECRET=
# Neon, or with --profile db: postgres://tmr:<POSTGRES_PASSWORD>@postgres:5432/ten_minutes_review
DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
# The web app sends account email; the worker sends the daily quiz.
WEB_EMAIL_FROM=Ten Minutes Review <no-reply@contact.example.com>
WORKER_EMAIL_FROM=Ten Minutes Review <quiz@contact.example.com>

BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Storage ----------------------------------------------------------------
# Any S3-compatible store: Cloudflare R2, Backblaze B2, or MinIO on this host.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Hosted stores need their endpoint, for example R2 (which uses S3_REGION=auto):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MinIO on this host (--profile storage):
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true

# --- Postgres on this host (--profile db) -----------------------------------
# POSTGRES_PASSWORD=
