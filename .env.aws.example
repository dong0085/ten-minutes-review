# Plan B: self-hosted stack (docker-compose). See docs/DEPLOY-AWS.md.
# This example is a complete local stack: mock LLM, console email, MinIO storage.
STORAGE_PROVIDER=s3

DATABASE_URL=postgres://tmr:tmr@postgres:5432/ten_minute_review
AUTH_SECRET=change-me-in-production
APP_URL=http://localhost:3000
INVITE_ONLY=true
INVITE_CODE=dev-invite

LLM_PROVIDER=mock
EMAIL_PROVIDER=console
EMAIL_FROM=Ten Minutes Review <you@example.com>

# MinIO (local S3-compatible storage started by docker-compose).
S3_BUCKET=tmr-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tmr-minio
S3_SECRET_ACCESS_KEY=tmr-minio-secret
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# Real AWS S3: clear S3_ENDPOINT and S3_FORCE_PATH_STYLE,
# set the bucket/region and an IAM key pair scoped to uploads/*.
# Real providers: LLM_PROVIDER=deepseek, EMAIL_PROVIDER=brevo or resend.

# Analytics (optional; localhost traffic is skipped by count.js)
# GOATCOUNTER_URL=https://ten-minutes.goatcounter.com/count

# docker-compose infra (defaults shown here; override in production)
# POSTGRES_USER=tmr
# POSTGRES_PASSWORD=tmr
# POSTGRES_DB=ten_minute_review
# MINIO_ROOT_USER=tmr-minio
# MINIO_ROOT_PASSWORD=tmr-minio-secret
